+
+
+#ifndef SDL_ps5mouse_h_
+#define SDL_ps5mouse_h_
+
+#include "../../SDL_internal.h"
+
+#include "SDL_surface.h"
+
+/* Sets up the cursor callbacks and the pointer's warping. */
+void PS5_Mouse_Init(void);
+
+/* Draws the current cursor into a frame that is about to be shown; returns whether it did. */
+SDL_bool PS5_Mouse_DrawCursor(SDL_Surface *surface);
+
+/* Puts back the pixels PS5_Mouse_DrawCursor covered. */
+void PS5_Mouse_UndrawCursor(SDL_Surface *surface);
+
+#endif /* SDL_ps5mouse_h_ */
diff --git a/src/video/ps5/SDL_ps5video.c b/src/video/ps5/SDL_ps5video.c
index 24e9085d..305dbfd6 100644
--- a/src/video/ps5/SDL_ps5video.c
+++ b/src/video/ps5/SDL_ps5video.c
@@ -28,6 +28,10 @@
 #include "SDL_ps5video.h"
 #include "SDL_ps5keyboard.h"
 #include "SDL_ps5osmesa.h"
+#include "SDL_ps5mouse.h"
+
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
 
 /* Called with every finished frame before it is shown (the PS5 OpenRCT2 port captures frames
    for its console tests here). The pixels are SDL_PIXELFORMAT_ABGR8888. */
@@ -76,12 +80,25 @@ static int PS5_UpdateWindowFramebuffer(_THIS, SDL_Window *window,
     SDL_Surface *surface;
     struct kevent evt;
     int junk;
+    SDL_Rect whole;
+    SDL_bool cursor;
 
     surface = window->surface;
     if (!surface) {
         return SDL_SetError("Couldn't find surface for window");
     }
 
+    cursor = PS5_Mouse_DrawCursor(surface);
+    if (cursor) {
+        /* The cursor moves on its own: refresh the whole frame. */
+        whole.x = 0;
+        whole.y = 0;
+        whole.w = surface->w;
+        whole.h = surface->h;
+        rects = &whole;
+        numrects = 1;
+    }
+
     if (PS5_FrameCallback) {
         PS5_FrameCallback(surface->pixels, surface->w, surface->h, surface->pitch);
     }
@@ -104,6 +121,9 @@ static int PS5_UpdateWindowFramebuffer(_THIS, SDL_Window *window,
                          (device_data->surface->w - surface->w) / 2,
                          (device_data->surface->h - surface->h) / 2);
     }
+    if (cursor) {
+        PS5_Mouse_UndrawCursor(surface);
+    }
 
     if (sceVideoOutSubmitFlip(device_data->handle, idx, 1, frame_id)) {
         return SDL_SetError("sceVideoOutSubmitFlip: %s", strerror(errno));
@@ -264,6 +284,7 @@ static int PS5_VideoInit(_THIS)
     }
 
     SDL_AddVideoDisplay(&display, SDL_FALSE);
+    PS5_Mouse_Init();
 
     return 0;
 }
@@ -292,6 +313,8 @@ static void PS5_VideoQuit(_THIS)
 
 static int PS5_CreateWindow(_THIS, SDL_Window *window)
 {
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
     return 0;
 }
 
