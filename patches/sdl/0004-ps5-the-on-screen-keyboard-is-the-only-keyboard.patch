 #include "../SDL_sysvideo.h"
 
+/* Sets up the on-screen keyboard (the IME dialog). */
 int PS5_Keyboard_Init(void);
-int PS5_Keyboard_Open(void);
+
+/* Sends the on-screen keyboard's result, once it closes, as keyboard events and text. */
 int PS5_Keyboard_PumpEvents(void);
-int PS5_Keyboard_Close(void);
 
 SDL_bool PS5_HasScreenKeyboardSupport(_THIS);
 SDL_bool PS5_IsScreenKeyboardShown(_THIS, SDL_Window *window);
 
+/* Exported for applications: the next screen keyboard starts with text (UTF-8), which its result
+   then replaces, and takes at most max_length characters (0: no limit of the application's). */
+void PS5_SetScreenKeyboardText(const char *text, int max_length);
+
 void PS5_ShowScreenKeyboard(_THIS, SDL_Window *window);
 void PS5_HideScreenKeyboard(_THIS, SDL_Window *window);
 
