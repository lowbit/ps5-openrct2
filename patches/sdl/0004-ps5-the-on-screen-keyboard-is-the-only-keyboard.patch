-    Uint32 button;
-    SDL_Scancode scancode;
-} remote_btn_map[] = {
-    { PS5_PAD_BUTTON_UP,      SDL_SCANCODE_UP },
-    { PS5_PAD_BUTTON_DOWN,    SDL_SCANCODE_DOWN },
-    { PS5_PAD_BUTTON_LEFT,    SDL_SCANCODE_LEFT },
