+#pragma region Button hints
+
+    enum class Glyph : uint8_t
+    {
+        cross,
+        circle,
+        square,
+        triangle,
+        dpad,
+        // Drawn as a key cap with the button's name.
+        named,
+    };
+
+    struct Hint
+    {
+        Glyph glyph;
+        const char* button; // for Glyph::named
+        const char* action;
+    };
+
+    // 9 by 9 symbols, one bit per pixel, the lowest 9 bits from left to right; in the PlayStation's
+    // colours.
+    static constexpr int32_t kGlyphSize = 9;
+    static constexpr std::array<std::array<uint16_t, kGlyphSize>, 5> kGlyphBits = { {
+        { 0x101, 0x183, 0x0C6, 0x06C, 0x038, 0x06C, 0x0C6, 0x183, 0x101 },
+        { 0x07C, 0x0C6, 0x183, 0x183, 0x183, 0x183, 0x183, 0x0C6, 0x07C },
+        { 0x1FF, 0x1FF, 0x183, 0x183, 0x183, 0x183, 0x183, 0x1FF, 0x1FF },
+        { 0x010, 0x038, 0x038, 0x06C, 0x06C, 0x0C6, 0x0C6, 0x1FF, 0x1FF },
+        { 0x038, 0x038, 0x038, 0x1FF, 0x1FF, 0x1FF, 0x038, 0x038, 0x038 },
+    } };
+    static constexpr std::array<Drawing::Colour, 5> kGlyphColours = {
+        Drawing::Colour::lightBlue,   Drawing::Colour::brightRed, Drawing::Colour::brightPink,
+        Drawing::Colour::brightGreen, Drawing::Colour::white,
+    };
+    static constexpr int32_t kHintHeight = 13;
+    static constexpr int32_t kHintGap = 10;
+
+    static std::vector<Hint> CurrentHints()
+    {
+        if (RadialMenuShown())
+            return { { Glyph::named, "L", "Point" }, { Glyph::cross, nullptr, "Choose" }, { Glyph::circle, nullptr, "Close" } };
+        if (InputGetState() == InputState::dropdownActive)
+            return { { Glyph::dpad, nullptr, "Move" },
+                     { Glyph::cross, nullptr, "Choose" },
+                     { Glyph::circle, nullptr, "Close" } };
+
+        std::vector<Hint> hints;
+        const auto position = ContextGetCursorState()->position;
+        if (gLegacyScene == LegacyScene::titleSequence)
+        {
+            hints = { { Glyph::dpad, nullptr, "Move" }, { Glyph::cross, nullptr, "Select" } };
+            if (!IsOverPark(position))
+                hints.push_back({ Glyph::circle, nullptr, "Close" });
+            return hints;
+        }
+
+        if (!IsOverPark(position))
+        {
+            auto* w = GetWindowManager()->FindFromPoint(position);
+            hints = { { Glyph::dpad, nullptr, "Move" }, { Glyph::cross, nullptr, "Select" } };
+            if (w != nullptr && IsNavigable(*w)
+                && std::count_if(
+                       w->widgets.begin(), w->widgets.end(),
+                       [](const Widget& widget) { return widget.type == WidgetType::tab && widget.isVisible(); })
+                    > 1)
+                hints.push_back({ Glyph::named, "L1 R1", "Tabs" });
+            if (w != nullptr && IsClosable(*w))
+                hints.push_back({ Glyph::circle, nullptr, "Close" });
+            return hints;
+        }
+
+        switch (BuildingMode())
+        {
+            case Building::track:
+                return { { Glyph::dpad, nullptr, "Piece" },         { Glyph::cross, nullptr, "Build" },
+                         { Glyph::square, nullptr, "Remove" },      { Glyph::named, "L1 R1", "Bank" },
+                         { Glyph::triangle, nullptr, "Lift hill" }, { Glyph::circle, nullptr, "Done" } };
+            case Building::path:
+                return { { Glyph::dpad, nullptr, "Piece" },
+                         { Glyph::cross, nullptr, "Build" },
+                         { Glyph::square, nullptr, "Remove" },
+                         { Glyph::circle, nullptr, "Done" } };
+            case Building::none:
+                break;
+        }
+        if (gInputFlags.has(InputFlag::toolActive))
+        {
+            hints = { { Glyph::cross, nullptr, "Place" } };
+            if (isToolActive(WindowClass::scenery) && WindowSceneryCanRaise())
+                hints.insert(hints.begin(), { Glyph::dpad, nullptr, "Height" });
+            if (RotateConstructionObject(false))
+                hints.push_back({ Glyph::triangle, nullptr, "Rotate" });
+            hints.push_back({ Glyph::circle, nullptr, "Done" });
+            return hints;
+        }
+        return { { Glyph::named, "OPTIONS", "Build" }, { Glyph::triangle, nullptr, "Park" },
+                 { Glyph::cross, nullptr, "Select" },  { Glyph::square, nullptr, "Remove" },
+                 { Glyph::named, "L1 R1", "Rotate" },  { Glyph::named, "L2 R2", "Zoom" } };
+    }
+
+    static int32_t GlyphWidth(const Hint& hint)
+    {
+        if (hint.glyph != Glyph::named)
+            return kGlyphSize;
+        return Drawing::getStringWidth(hint.button, FontStyle::small) + 6;
+    }
+
+    static void DrawGlyph(Drawing::RenderTarget& rt, const Hint& hint, const ScreenCoordsXY& at)
+    {
+        using namespace OpenRCT2::Drawing;
+        const auto black = getColourMap(Colour::black).darkest;
+        if (hint.glyph == Glyph::named)
+        {
+            // A key cap with the button's name.
+            const ScreenRect cap = { at + ScreenCoordsXY{ 0, -1 }, at + ScreenCoordsXY{ GlyphWidth(hint) - 1, kGlyphSize } };
+            Rectangle::fill(rt, cap, getColourMap(Colour::grey).midLight);
+            Rectangle::fill(
+                rt, { cap.Point1 + ScreenCoordsXY{ 1, 1 }, cap.Point2 - ScreenCoordsXY{ 1, 1 } },
+                getColourMap(Colour::black).light);
+            drawText(rt, at + ScreenCoordsXY{ 3, 0 }, hint.button, { Colour::white, FontStyle::small });
+            return;
+        }
+
+        const auto& bits = kGlyphBits[static_cast<size_t>(hint.glyph)];
+        const auto colour = getColourMap(kGlyphColours[static_cast<size_t>(hint.glyph)]).light;
+        // A shadow one pixel down and right keeps the symbol readable over any background.
+        for (const bool shadow : { true, false })
+        {
+            for (int32_t row = 0; row < kGlyphSize; row++)
+            {
+                for (int32_t column = 0; column < kGlyphSize; column++)
+                {
+                    if (!(bits[row] & (0x100 >> column)))
+                        continue;
+                    const auto pixel = at + ScreenCoordsXY{ column + shadow, row + shadow };
+                    Rectangle::fill(rt, { pixel, pixel }, shadow ? black : colour);
+                }
+            }
+        }
+    }
+
+    void Gamepad::drawHints(Drawing::RenderTarget& rt)
+    {
+        using namespace OpenRCT2::Drawing;
+        static ScreenRect lastArea{};
+
+        const auto hints = CurrentHints();
+        int32_t width = -kHintGap;
+        for (const auto& hint : hints)
+            width += GlyphWidth(hint) + 3 + getStringWidth(hint.action, FontStyle::medium) + kHintGap;
+
+        // In the middle of the bottom toolbar, where windows are out of reach anyway, unless it shows
+        // news; on the title screen at the bottom.
+        ScreenCoordsXY centre = { ContextGetWidth() / 2, ContextGetHeight() - kHintHeight / 2 - 3 };
+        if (auto* toolbar = GetWindowManager()->FindByClass(WindowClass::bottomToolbar))
+        {
+            centre = toolbar->windowPos + ScreenCoordsXY{ toolbar->width / 2, toolbar->height / 2 };
+            if (!News::IsQueueEmpty())
+            {
+                GfxSetDirtyBlocks(lastArea);
+                lastArea = {};
+                return;
+            }
+        }
+        const ScreenRect area = { centre - ScreenCoordsXY{ width / 2 + 6, kHintHeight / 2 + 1 },
+                                  centre + ScreenCoordsXY{ width / 2 + 6, kHintHeight / 2 + 1 } };
+
+        Rectangle::filter(rt, area, FilterPaletteID::paletteDarken2);
+        ScreenCoordsXY at = { area.GetLeft() + 6, area.GetTop() + 3 };
+        for (const auto& hint : hints)
+        {
+            DrawGlyph(rt, hint, at);
+            at.x += GlyphWidth(hint) + 3;
+            drawText(rt, at + ScreenCoordsXY{ 0, -1 }, hint.action, { Colour::white });
+            at.x += getStringWidth(hint.action, FontStyle::medium) + kHintGap;
+        }
+
+        // Drawn over the windows each frame: the area under it, and where it was, redraw next time.
+        GfxSetDirtyBlocks(area);
+        if (lastArea.Point1 != area.Point1 || lastArea.Point2 != area.Point2)
+            GfxSetDirtyBlocks(lastArea);
+        lastArea = area;
+    }
+
 #pragma endregion
 } // namespace OpenRCT2::Ui
