+    // Below this tilt the stick counts as centred: worn sticks drift.
+    static constexpr float kDeadzone = 0.08f;
+    // At full tilt the pointer crosses the window's height in this time...
+    static constexpr float kSecondsPerHeight = 1.0f;
+    // ...and once the stick has stayed there for kAccelerationDelay, it speeds up to
+    // kAccelerationFactor times that over kAccelerationTime, for crossing the whole screen.
+    static constexpr float kAccelerationDelay = 0.25f;
+    static constexpr float kAccelerationTime = 0.5f;
+    static constexpr float kAccelerationFactor = 2.2f;
+    // Over a button the pointer slows down to this fraction, so it is easy to stop on one.
+    static constexpr float kButtonFriction = 0.5f;
+    // The longest frame the movement accounts for, so a stall does not throw the pointer away.
+    static constexpr float kMaxFrameSeconds = 0.1f;
+    // A held d-pad direction, trigger or build button repeats after this, then at this interval.
+    static constexpr uint32_t kRepeatDelayMs = 380;
+    static constexpr uint32_t kRepeatIntervalMs = 110;
+    static constexpr uint32_t kBuildRepeatIntervalMs = 220;
+    // The pointer glides to where the d-pad sends it in this time.
+    static constexpr uint32_t kGlideMs = 70;
+    // Moving to a widget of another window costs this much more than an equally near one in the same.
+    static constexpr int32_t kOtherWindowPenalty = 20;
