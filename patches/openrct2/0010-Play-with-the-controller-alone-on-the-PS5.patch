+    struct Target
+    {
+        WindowBase* window;
+        WidgetIndex widget; // kWidgetIndexNull for a dropdown item
+        ScreenRect rect;
+    };
+
+#pragma region What the pointer can go to
+
+    static ScreenRect WidgetRect(const WindowBase& w, WidgetIndex index)
+    {
+        const auto& widget = w.widgets[index];
+        return { w.windowPos + ScreenCoordsXY{ widget.left, widget.top },
+                 w.windowPos + ScreenCoordsXY{ widget.right, widget.bottom } };
+    }
+
+    static ScreenCoordsXY Centre(const ScreenRect& rect)
+    {
+        return { (rect.GetLeft() + rect.GetRight()) / 2, (rect.GetTop() + rect.GetBottom()) / 2 };
+    }
+
+    // Windows the d-pad moves through: not the park behind them, tooltips or dropdowns.
+    static bool IsNavigable(const WindowBase& w)
+    {
+        return w.isVisible && w.classification != WindowClass::mainWindow && w.classification != WindowClass::tooltip
+            && w.classification != WindowClass::dropdown;
+    }
+
+    // Windows Circle may close: those with a close button.
+    static bool IsClosable(const WindowBase& w)
+    {
+        return IsNavigable(w)
+            && std::any_of(w.widgets.begin(), w.widgets.end(), [](const Widget& widget) {
+                   return widget.type == WidgetType::closeBox && widget.isVisible();
+               });
+    }
+
+    static bool IsTarget(const WindowBase& w, WidgetIndex index)
+    {
+        const auto& widget = w.widgets[index];
+        if (!widget.isVisible() || widgetIsDisabled(w, index))
+            return false;
+        switch (widget.type)
+        {
+            case WidgetType::colourBtn:
+            case WidgetType::trnBtn:
+            case WidgetType::tab:
+            case WidgetType::flatBtn:
+            case WidgetType::hiddenButton:
+            case WidgetType::button:
+            case WidgetType::tableHeader:
+            case WidgetType::dropdownMenu:
+            case WidgetType::checkbox:
+            case WidgetType::textBox:
+            case WidgetType::scroll:
+                return true;
+            case WidgetType::imgBtn:
+                // Image buttons are also used for pictures; the real ones say what they do.
+                return widget.tooltip != kStringIdNone || widget.sztooltip != nullptr;
+            default:
+                return false;
+        }
+    }
+
+    static bool IsOverPark(const ScreenCoordsXY& position)
+    {
+        auto* w = GetWindowManager()->FindFromPoint(position);
+        return w == nullptr || w->classification == WindowClass::mainWindow || w->classification == WindowClass::viewport;
+    }
+
+    static std::optional<Target> TargetAt(const ScreenCoordsXY& position)
+    {
+        auto* windowMgr = GetWindowManager();
+        auto* w = windowMgr->FindFromPoint(position);
+        if (w == nullptr)
+            return std::nullopt;
+        if (w->classification == WindowClass::dropdown)
+        {
+            const auto index = DropdownIndexFromPoint(position, w);
+            if (auto rect = DropdownItemRect(index))
+                return Target{ w, kWidgetIndexNull, *rect };
+            return std::nullopt;
+        }
+        if (!IsNavigable(*w))
+            return std::nullopt;
+        const auto index = windowMgr->FindWidgetFromPoint(*w, position);
+        if (index == kWidgetIndexNull || !IsTarget(*w, index))
+            return std::nullopt;
+        return Target{ w, index, WidgetRect(*w, index) };
+    }
+
+    // Everything a click could reach: the items of an open dropdown (nothing else then), or the
+    // widgets of every window that no other window or widget covers.
+    static std::vector<Target> CollectTargets()
+    {
+        std::vector<Target> targets;
+        auto* windowMgr = GetWindowManager();
+        if (InputGetState() == InputState::dropdownActive)
+        {
+            auto* dropdown = windowMgr->FindByClass(WindowClass::dropdown);
+            for (int32_t i = 0; dropdown != nullptr && i < gDropdown.numItems; i++)
+            {
+                const auto& item = gDropdown.items[i];
+                if (item.isSeparator() || item.isDisabled())
+                    continue;
+                if (auto rect = DropdownItemRect(i))
+                    targets.push_back({ dropdown, kWidgetIndexNull, *rect });
+            }
+            return targets;
+        }
+
+        WindowVisitEach([&](WindowBase* w) {
+            if (!IsNavigable(*w))
+                return;
+            for (WidgetIndex i = 0; i < w->widgets.size(); i++)
+            {
+                if (!IsTarget(*w, i))
+                    continue;
+                const auto rect = WidgetRect(*w, i);
+                const auto centre = Centre(rect);
+                if (windowMgr->FindFromPoint(centre) == w && windowMgr->FindWidgetFromPoint(*w, centre) == i)
+                    targets.push_back({ w, i, rect });
+            }
+        });
+        return targets;
+    }
+
+    // How far `to` is from `from` going in direction (dx, dy), or nothing when it is not that
+    // way: the gap along the direction, plus the gap and offset across it, which count more, so
+    // the pointer moves along rows and columns rather than jumping diagonally.
+    static std::optional<int32_t> Distance(const ScreenRect& from, const ScreenRect& to, int32_t dx, int32_t dy)
+    {
+        const auto fromCentre = Centre(from);
+        const auto toCentre = Centre(to);
+        int32_t along, gapAcross, offsetAcross;
+        if (dx != 0)
+        {
+            if ((toCentre.x - fromCentre.x) * dx <= 0)
+                return std::nullopt;
+            along = dx > 0 ? to.GetLeft() - from.GetRight() : from.GetLeft() - to.GetRight();
+            gapAcross = std::max({ 0, to.GetTop() - from.GetBottom(), from.GetTop() - to.GetBottom() });
+            offsetAcross = std::abs(toCentre.y - fromCentre.y);
+        }
+        else
+        {
+            if ((toCentre.y - fromCentre.y) * dy <= 0)
+                return std::nullopt;
+            along = dy > 0 ? to.GetTop() - from.GetBottom() : from.GetTop() - to.GetBottom();
+            gapAcross = std::max({ 0, to.GetLeft() - from.GetRight(), from.GetLeft() - to.GetRight() });
+            offsetAcross = std::abs(toCentre.x - fromCentre.x);
+        }
+        return std::max(along, 0) + 3 * gapAcross + offsetAcross / 4;
+    }
+
+    // Whether the two overlap across the direction (dx, dy): side by side, or one above the other.
+    static bool Overlap(const ScreenRect& a, const ScreenRect& b, int32_t dx, int32_t dy)
+    {
+        if (dx != 0)
+            return a.GetTop() <= b.GetBottom() && b.GetTop() <= a.GetBottom();
+        return a.GetLeft() <= b.GetRight() && b.GetLeft() <= a.GetRight();
+    }
+
+#pragma endregion
+
+#pragma region Lists
+
+    struct List
+    {
+        WindowBase& window;
+        WidgetIndex widget;
+        ScrollArea& scroll;
+        std::vector<ScreenRect> items; // in the list's own coordinates
+        ScreenRect view;               // the visible part, on the screen
+
+        ScreenCoordsXY origin() const
+        {
+            const auto& w = window.widgets[widget];
+            return window.windowPos + ScreenCoordsXY{ w.left + 1 - scroll.contentOffsetX, w.top + 1 - scroll.contentOffsetY };
+        }
+
+        ScreenRect onScreen(const ScreenRect& item) const
+        {
+            const auto at = origin();
+            return { item.Point1 + at, ScreenCoordsXY{ std::min(item.GetRight() + at.x, view.GetRight()), item.GetBottom() + at.y } };
+        }
+
+        void update()
+        {
+            widgetScrollUpdateThumbs(window, widget);
+            window.invalidate();
+        }
+
+        // Scrolls so that the item is in view.
+        void reveal(const ScreenRect& item)
+        {
+            const int32_t viewWidth = view.GetWidth() + 1;
+            const int32_t viewHeight = view.GetHeight() + 1;
+            if (item.GetTop() < scroll.contentOffsetY)
+                scroll.contentOffsetY = item.GetTop();
+            else if (item.GetBottom() >= scroll.contentOffsetY + viewHeight)
+                scroll.contentOffsetY = item.GetBottom() + 1 - viewHeight;
+            if (item.GetRight() != kListItemFullWidth)
+            {
+                if (item.GetLeft() < scroll.contentOffsetX)
+                    scroll.contentOffsetX = item.GetLeft();
+                else if (item.GetRight() >= scroll.contentOffsetX + viewWidth)
+                    scroll.contentOffsetX = item.GetRight() + 1 - viewWidth;
+            }
+            scroll.contentOffsetY = std::clamp<int32_t>(scroll.contentOffsetY, 0, std::max(0, scroll.contentHeight - viewHeight));
+            scroll.contentOffsetX = std::clamp<int32_t>(scroll.contentOffsetX, 0, std::max(0, scroll.contentWidth - viewWidth));
+            update();
+        }
+    };
+
+    static List GetList(WindowBase& w, WidgetIndex index)
+    {
+        const int32_t scrollIndex = WindowGetScrollDataIndex(w, index);
+        auto& scroll = w.scrolls[scrollIndex];
+        const auto& widget = w.widgets[index];
+        const int32_t right = widget.right - (scroll.flags.has(ScrollFlag::vScrollbarVisible) ? kScrollBarWidth + 1 : 1);
+        const int32_t bottom = widget.bottom - (scroll.flags.has(ScrollFlag::hScrollbarVisible) ? kScrollBarWidth + 1 : 1);
+        return List{ w, index, scroll, w.onScrollGetItems(scrollIndex),
+                     { w.windowPos + ScreenCoordsXY{ widget.left + 1, widget.top + 1 }, w.windowPos + ScreenCoordsXY{ right, bottom } } };
+    }
+
+    static int32_t DistanceSquared(const ScreenRect& rect, const ScreenCoordsXY& point)
+    {
+        const int32_t x = std::max({ 0, rect.GetLeft() - point.x, point.x - rect.GetRight() });
+        const int32_t y = std::max({ 0, rect.GetTop() - point.y, point.y - rect.GetBottom() });
+        return x * x + y * y;
+    }
+
+    // Where the pointer goes on a list it moves onto: the visible item nearest to it.
+    static ScreenCoordsXY EnterList(List& list, const ScreenCoordsXY& from)
+    {
+        const auto top = list.scroll.contentOffsetY;
+        const auto bottom = top + list.view.GetHeight();
+        const ScreenRect* best = nullptr;
+        int32_t bestDistance = std::numeric_limits<int32_t>::max();
+        for (const auto& item : list.items)
+        {
+            if (item.GetBottom() < top || item.GetTop() > bottom)
+                continue;
+            const auto distance = DistanceSquared(list.onScreen(item), from);
+            if (distance < bestDistance)
+            {
+                best = &item;
+                bestDistance = distance;
+            }
+        }
+        if (best == nullptr)
+            return Centre(list.view);
+        list.reveal(*best);
+        return Centre(list.onScreen(*best));
+    }
+
+    // Moves within a list: from item to item, or along a slider; nothing at the list's edge.
+    static std::optional<ScreenCoordsXY> MoveInList(List& list, const ScreenCoordsXY& position, int32_t dx, int32_t dy)
+    {
+        if (list.items.empty())
+        {
+            // A slider or a wide table: left and right move it.
+            if (dx == 0 || !list.scroll.flags.has(ScrollFlag::hScrollbarVisible))
+                return std::nullopt;
+            const int32_t range = std::max(0, list.scroll.contentWidth - list.view.GetWidth() - 1);
+            list.scroll.contentOffsetX = std::clamp(list.scroll.contentOffsetX + dx * std::max(1, range / 20), 0, range);
+            list.update();
+            return position;
+        }
+
+        const auto contentPosition = position - list.origin();
+        size_t current = 0;
+        int32_t currentDistance = std::numeric_limits<int32_t>::max();
+        for (size_t i = 0; i < list.items.size(); i++)
+        {
+            const auto distance = DistanceSquared(list.items[i], contentPosition);
+            if (distance < currentDistance)
+            {
+                current = i;
+                currentDistance = distance;
+            }
+        }
+
+        std::optional<size_t> next;
+        int32_t nextDistance = std::numeric_limits<int32_t>::max();
+        for (size_t i = 0; i < list.items.size(); i++)
+        {
+            if (i == current)
+                continue;
+            if (auto distance = Distance(list.items[current], list.items[i], dx, dy); distance && *distance < nextDistance)
+            {
+                next = i;
+                nextDistance = *distance;
+            }
+        }
+        if (!next)
+            return std::nullopt;
+
+        const auto& item = list.items[*next];
+        list.reveal(item);
+        auto destination = Centre(list.onScreen(item));
+        // Rows keep the pointer in its column.
+        if (item.GetRight() == kListItemFullWidth)
+            destination.x = std::clamp(position.x, list.view.GetLeft() + 2, list.view.GetRight() - 2);
+        return destination;
+    }
+
+#pragma endregion
+
+    static Building BuildingMode()
+    {
+        if (GetWindowManager()->FindByClass(WindowClass::rideConstruction) != nullptr)
+        {
+            switch (_rideConstructionState)
+            {
+                case RideConstructionState::front:
+                case RideConstructionState::back:
+                case RideConstructionState::selected:
+                    return Building::track;
+                default:
+                    break;
+            }
+        }
+        return WindowFootpathInBridgeMode() ? Building::path : Building::none;
+    }
+
+    static void RunShortcut(std::string_view id)
+    {
+        if (auto* shortcut = GetShortcutManager().getShortcut(id))
+            shortcut->action();
+    }
+
+    void Gamepad::update(const std::vector<SDL_GameController*>& controllers)
+    {
+        _controllers = controllers;
+        const uint32_t ticks = SDL_GetTicks();
+        _frameSeconds = _ticks == 0 ? 0.0f : std::min((ticks - _ticks) / 1000.0f, kMaxFrameSeconds);
+        _ticks = ticks;
+
+        _window = SDL_GetMouseFocus();
+        if (_window == nullptr)
+            return;
+        if (!_placed)
+        {
+            // Start in the middle rather than in a corner.
+            int width, height;
+            SDL_GetWindowSize(_window, &width, &height);
+            SDL_WarpMouseInWindow(_window, width / 2, height / 2);
+            _placed = true;
+        }
+
+        readButtons();
+        movePointer();
+        handleButtons();
+    }
+
+#pragma region Buttons
+
+    void Gamepad::readButtons()
+    {
+        for (uint8_t b = 0; b < Button::count; b++)
+        {
+            bool down = false;
+            for (auto* controller : _controllers)
+            {
+                if (b == Button::l2 || b == Button::r2)
+                {
+                    auto* joystick = SDL_GameControllerGetJoystick(controller);
+                    down |= joystick != nullptr
+                        && SDL_JoystickGetButton(joystick, b == Button::l2 ? kL2JoystickButton : kR2JoystickButton) != 0;
+                }
+                else
+                {
+                    down |= SDL_GameControllerGetButton(controller, kButtonMap[b]) != 0;
+                }
+            }
+
+            auto& state = _buttons[b];
+            const bool repeats = b >= Button::up || b == Button::l2 || b == Button::r2;
+            state.fired = false;
+            if (down && !state.held)
+            {
+                state.fired = true;
+                state.pressedAt = _ticks;
+                state.repeatAt = _ticks + kRepeatDelayMs;
+            }
+            else if (down && repeats && _ticks >= state.repeatAt)
+            {
+                state.fired = true;
+                state.repeatAt = _ticks + kRepeatIntervalMs;
+            }
+            state.held = down;
+        }
+    }
+
+    bool Gamepad::fired(Button button) const
+    {
+        return _buttons[button].fired;
+    }
+
+    bool Gamepad::held(Button button) const
+    {
+        return _buttons[button].held;
+    }
+
+    float Gamepad::axis(int axis) const
+    {
+        float value = 0.0f;
+        for (auto* controller : _controllers)
+        {
+            const float v = SDL_GameControllerGetAxis(controller, static_cast<SDL_GameControllerAxis>(axis)) / 32767.0f;
+            if (std::abs(v) > std::abs(value))
+                value = v;
+        }
+        return std::clamp(value, -1.0f, 1.0f);
+    }
+
+    void Gamepad::handleButtons()
+    {
+        const auto position = pointer();
+        const bool overPark = IsOverPark(position);
+        const auto building = overPark ? BuildingMode() : Building::none;
+
+        // A dropdown opened with Cross gets the pointer once Cross is let go: letting go over an
+        // item would pick it.
+        const bool dropdownOpen = InputGetState() == InputState::dropdownActive;
+        if (dropdownOpen && !_dropdownOpen)
+            _crossOpenedDropdown = held(Button::cross);
+        if (dropdownOpen && _crossOpenedDropdown && !held(Button::cross) && _crossPress == Press::none)
+        {
+            _crossOpenedDropdown = false;
+            int32_t index = -1;
+            for (int32_t i = 0; i < gDropdown.numItems && index == -1; i++)
+                if (gDropdown.items[i].isChecked() && !gDropdown.items[i].isDisabled())
+                    index = i;
+            for (int32_t i = 0; i < gDropdown.numItems && index == -1; i++)
+                if (!gDropdown.items[i].isSeparator() && !gDropdown.items[i].isDisabled())
+                    index = i;
+            if (auto rect = DropdownItemRect(index))
+                sendPointerTo(Centre(*rect));
+        }
+        _dropdownOpen = dropdownOpen;
+
+        // Cross: click, or build the next piece.
+        if (fired(Button::cross))
+        {
+            if (building != Building::none)
+            {
+                _crossPress = Press::construction;
+                RunShortcut(ShortcutId::kWindowRideConstructionBuild);
+                rumble(0x4000, 0x4000, 40);
+            }
+            else
+            {
+                _crossPress = Press::mouse;
+                rumble(0x1800, 0x2400, 18);
+            }
+        }
+        else if (held(Button::cross) && _crossPress == Press::construction && _ticks >= _buttons[Button::cross].repeatAt)
+        {
+            // Holding Cross keeps building.
+            _buttons[Button::cross].repeatAt = _ticks + kBuildRepeatIntervalMs;
+            RunShortcut(ShortcutId::kWindowRideConstructionBuild);
+            rumble(0x4000, 0x4000, 40);
+        }
+        else if (!held(Button::cross))
+        {
+            _crossPress = Press::none;
+        }
+
+        // Square: right-click, or take the last piece away.
+        if (fired(Button::square))
+        {
+            if (building != Building::none)
+            {
+                _squarePress = Press::construction;
+                RunShortcut(ShortcutId::kWindowRideConstructionDemolish);
+                rumble(0x3000, 0x1000, 40);
+            }
+            else
+            {
+                _squarePress = Press::mouse;
+            }
+        }
+        else if (!held(Button::square))
+        {
+            _squarePress = Press::none;
+        }
+
+        setButton(SDL_BUTTON_LEFT, _crossPress == Press::mouse || held(Button::touchpad), _left);
+        setButton(SDL_BUTTON_RIGHT, _squarePress == Press::mouse, _right);
+
+        if (fired(Button::circle))
+            back();
+
+        if (fired(Button::triangle))
+        {
+            if (!RotateConstructionObject() && building == Building::track)
+                RunShortcut(ShortcutId::kWindowRideConstructionChainLift);
+        }
+
+        if (fired(Button::options) && gLegacyScene != LegacyScene::titleSequence)
+            QuickMenuToggle();
+
+        // L1 and R1: the tabs of the window under the pointer, banking while building track,
+        // otherwise the view.
+        for (const auto& [button, step] : { std::pair{ Button::l1, -1 }, std::pair{ Button::r1, 1 } })
+        {
+            if (!fired(button))
+                continue;
+            if (building == Building::track)
+                RunShortcut(step < 0 ? ShortcutId::kWindowRideConstructionBankLeft : ShortcutId::kWindowRideConstructionBankRight);
+            else if (!switchTab(step))
+                RunShortcut(step < 0 ? ShortcutId::kViewGeneralRotateAnticlockwise : ShortcutId::kViewGeneralRotateClockwise);
+        }
+        if (fired(Button::r3))
+            RunShortcut(ShortcutId::kViewGeneralRotateClockwise);
+        if (fired(Button::l3))
+            RunShortcut(ShortcutId::kInterfacePause);
+
+        // L2 and R2 zoom, towards the pointer when it is over the park.
+        if (fired(Button::l2) && gLegacyScene != LegacyScene::titleSequence)
+            MainWindowZoom(false, overPark);
+        if (fired(Button::r2) && gLegacyScene != LegacyScene::titleSequence)
+            MainWindowZoom(true, overPark);
+
+        // The d-pad: the piece to build, or the next button that way.
+        for (const auto& [button, dx, dy] : { std::tuple{ Button::up, 0, -1 }, std::tuple{ Button::down, 0, 1 },
+                                             std::tuple{ Button::left, -1, 0 }, std::tuple{ Button::right, 1, 0 } })
+        {
+            if (!fired(button))
+                continue;
+            if (building != Building::none)
+            {
+                if (dx != 0)
+                    RunShortcut(dx < 0 ? ShortcutId::kWindowRideConstructionTurnLeft : ShortcutId::kWindowRideConstructionTurnRight);
+                else
+                    RunShortcut(dy < 0 ? ShortcutId::kWindowRideConstructionSlopeUp : ShortcutId::kWindowRideConstructionSlopeDown);
+                rumble(0, 0x2000, 15);
+            }
+            else
+            {
+                handleDirection(dx, dy);
+            }
+        }
+    }
+
+    // Circle: closes what is most in the way, one thing per press.
+    void Gamepad::back()
+    {
+        auto* windowMgr = GetWindowManager();
+        if (InputGetState() == InputState::dropdownActive)
+        {
+            windowMgr->CloseByClass(WindowClass::dropdown);
+            gInputFlags.unset(InputFlag::widgetPressed);
+            InputSetState(InputState::reset);
+            return;
+        }
+        if (auto* error = windowMgr->FindByClass(WindowClass::error))
+        {
+            windowMgr->Close(*error);
+            return;
+        }
+        if (GetCurrentTextBox().window.classification != WindowClass::null)
+        {
+            WindowCancelTextbox();
+            return;
+        }
+        if (gInputFlags.has(InputFlag::toolActive))
+        {
+            // The tool windows (scenery, paths, land...) go with their tool.
+            auto* toolWindow = windowMgr->FindByNumber(gCurrentToolWidget.windowClassification, gCurrentToolWidget.windowNumber);
+            switch (gCurrentToolWidget.windowClassification)
+            {
+                case WindowClass::scenery:
+                case WindowClass::footpath:
+                case WindowClass::land:
+                case WindowClass::water:
+                case WindowClass::clearScenery:
+                case WindowClass::landRights:
+                case WindowClass::trackDesignPlace:
+                    if (toolWindow != nullptr)
+                    {
+                        windowMgr->Close(*toolWindow);
+                        return;
+                    }
+                    break;
+                default:
+                    break;
+            }
+            ToolCancel();
+            return;
+        }
+        // The window under the pointer, or else the frontmost one.
+        auto* w = windowMgr->FindFromPoint(pointer());
+        if (w == nullptr || !IsClosable(*w))
+        {
+            w = nullptr;
+            WindowVisitEach([&w](WindowBase* candidate) {
+                if (IsClosable(*candidate))
+                    w = candidate;
+            });
+        }
+        if (w != nullptr)
+            windowMgr->Close(*w);
+    }
+
+    // L1 and R1 over a window with tabs: the previous or next one, round the end.
+    bool Gamepad::switchTab(int step)
+    {
+        auto* w = GetWindowManager()->FindFromPoint(pointer());
+        if (w == nullptr || !IsNavigable(*w))
+            return false;
+        std::vector<WidgetIndex> tabs;
+        for (WidgetIndex i = 0; i < w->widgets.size(); i++)
+            if (w->widgets[i].type == WidgetType::tab && IsTarget(*w, i))
+                tabs.push_back(i);
+        if (tabs.size() < 2)
+            return false;
+        std::sort(tabs.begin(), tabs.end(), [w](WidgetIndex a, WidgetIndex b) {
+            const auto& wa = w->widgets[a];
+            const auto& wb = w->widgets[b];
+            return wa.top != wb.top ? wa.top < wb.top : wa.left < wb.left;
+        });
+        const auto current = std::find_if(tabs.begin(), tabs.end(), [w](WidgetIndex i) { return widgetIsPressed(*w, i); });
+        const int32_t count = static_cast<int32_t>(tabs.size());
+        const int32_t index = current == tabs.end() ? 0 : static_cast<int32_t>(current - tabs.begin());
+        clickAt(Centre(WidgetRect(*w, tabs[((index + step) % count + count) % count])));
+        rumble(0, 0x2000, 15);
+        return true;
+    }
+
+#pragma endregion
+
+#pragma region The d-pad
+
+    void Gamepad::handleDirection(int dx, int dy)
+    {
+        const auto position = _gliding ? _glideTo : pointer();
+        const auto current = TargetAt(position);
+
+        // Within a list or along a slider first.
+        if (current && current->widget != kWidgetIndexNull && current->window->widgets[current->widget].type == WidgetType::scroll)
+        {
+            auto list = GetList(*current->window, current->widget);
+            if (auto destination = MoveInList(list, position, dx, dy))
+            {
+                sendPointerTo(*destination);
+                rumble(0, 0x2400, 15);
+                return;
+            }
+        }
+
+        const ScreenRect from = current ? current->rect : ScreenRect{ position, position };
+        const Target* best = nullptr;
+        int32_t bestDistance = std::numeric_limits<int32_t>::max();
+        const auto targets = CollectTargets();
+        for (const auto& target : targets)
+        {
+            if (current && target.window == current->window && target.widget == current->widget
+                && target.rect.Point1 == current->rect.Point1)
+                continue;
+            auto distance = Distance(from, target.rect, dx, dy);
+            if (!distance)
+                continue;
+            // From a window, only to another window that lies that way, not off to the side.
+            if (current && target.window != current->window)
+            {
+                const auto& w = *current->window;
+                if (!Overlap({ w.windowPos, w.windowPos + ScreenCoordsXY{ w.width - 1, w.height - 1 } }, target.rect, dx, dy))
+                    continue;
+                *distance += kOtherWindowPenalty;
+            }
+            if (*distance < bestDistance)
+            {
+                best = &target;
+                bestDistance = *distance;
+            }
+        }
+        if (best == nullptr)
+            return;
+
+        if (best->widget != kWidgetIndexNull && best->window->widgets[best->widget].type == WidgetType::scroll)
+        {
+            auto list = GetList(*best->window, best->widget);
+            sendPointerTo(EnterList(list, position));
+        }
+        else
+        {
+            sendPointerTo(Centre(best->rect));
+        }
+        rumble(0, 0x2400, 15);
+    }
+
+    bool Gamepad::scrollList(const ScreenCoordsXY& delta)
+    {
+        const auto position = ContextGetCursorState()->position;
+        const auto target = TargetAt(position);
+        if (!target || target->widget == kWidgetIndexNull
+            || target->window->widgets[target->widget].type != WidgetType::scroll)
+            return false;
+
+        auto list = GetList(*target->window, target->widget);
+        const int32_t maxX = std::max(0, list.scroll.contentWidth - list.view.GetWidth() - 1);
+        const int32_t maxY = std::max(0, list.scroll.contentHeight - list.view.GetHeight() - 1);
+        if (list.scroll.flags.has(ScrollFlag::hScrollbarVisible))
+            list.scroll.contentOffsetX = std::clamp(list.scroll.contentOffsetX + delta.x, 0, maxX);
+        if (list.scroll.flags.has(ScrollFlag::vScrollbarVisible))
+            list.scroll.contentOffsetY = std::clamp(list.scroll.contentOffsetY + delta.y, 0, maxY);
+        list.update();
+        return true;
+    }
+
+#pragma endregion
+
+#pragma region The pointer
+
+    ScreenCoordsXY Gamepad::pointer() const
+    {
+        int x, y;
+        SDL_GetMouseState(&x, &y);
+        const float scale = Config::Get().general.windowScale;
+        return { static_cast<int32_t>(x / scale), static_cast<int32_t>(y / scale) };
+    }
+
+    // Glides the pointer to a point of the interface.
+    void Gamepad::sendPointerTo(const ScreenCoordsXY& position)
+    {
+        _glideFrom = pointer();
+        _glideTo = position;
+        _glideStart = _ticks;
+        _gliding = true;
+        _remainderX = 0.0f;
+        _remainderY = 0.0f;
+    }
+
+    void Gamepad::movePointer()
+    {
+        int width, height;
+        SDL_GetWindowSize(_window, &width, &height);
+        const float scale = Config::Get().general.windowScale;
+
+        float moveX = 0.0f;
+        float moveY = 0.0f;
+        const float x = axis(SDL_CONTROLLER_AXIS_LEFTX);
+        const float y = axis(SDL_CONTROLLER_AXIS_LEFTY);
+        const float magnitude = std::hypot(x, y);
+        if (magnitude > kDeadzone)
+        {
+            const float tilt = std::min((magnitude - kDeadzone) / (1.0f - kDeadzone), 1.0f);
+            _fullTiltSeconds = tilt > 0.95f ? _fullTiltSeconds + _frameSeconds : 0.0f;
+            const float acceleration = 1.0f
+                + (kAccelerationFactor - 1.0f) * std::clamp((_fullTiltSeconds - kAccelerationDelay) / kAccelerationTime, 0.0f, 1.0f);
+            // Slow and precise near the centre, fast at full tilt.
+            float speed = std::pow(tilt, 1.8f) * height / kSecondsPerHeight * acceleration;
+            if (_fullTiltSeconds < kAccelerationDelay && TargetAt(pointer()).has_value())
+                speed *= kButtonFriction;
+            moveX = x / magnitude * speed * _frameSeconds;
+            moveY = y / magnitude * speed * _frameSeconds;
+            _gliding = false;
+        }
+        else
+        {
+            _fullTiltSeconds = 0.0f;
+        }
+
+        // The touchpad works like a laptop's: a stroke across all of it crosses the window.
+        bool touching = false;
+        float touchX = 0.0f;
+        float touchY = 0.0f;
+        for (auto* controller : _controllers)
+        {
+            uint8_t state = 0;
+            float fingerX, fingerY, pressure;
+            if (!touching && SDL_GameControllerGetNumTouchpads(controller) > 0
+                && SDL_GameControllerGetTouchpadFinger(controller, 0, 0, &state, &fingerX, &fingerY, &pressure) == 0
+                && state != 0)
+            {
+                touching = true;
+                touchX = fingerX;
+                touchY = fingerY;
+            }
+        }
+        if (touching && _touching)
+        {
+            moveX += (touchX - _touchX) * width;
+            moveY += (touchY - _touchY) * height;
+            _gliding = false;
+        }
+        _touching = touching;
+        _touchX = touchX;
+        _touchY = touchY;
+
+        if (_gliding)
+        {
+            const float t = std::min(static_cast<float>(_ticks - _glideStart) / kGlideMs, 1.0f);
+            const float eased = 1.0f - (1.0f - t) * (1.0f - t) * (1.0f - t);
+            const float atX = _glideFrom.x + (_glideTo.x - _glideFrom.x) * eased;
+            const float atY = _glideFrom.y + (_glideTo.y - _glideFrom.y) * eased;
+            SDL_WarpMouseInWindow(_window, static_cast<int>((atX + 0.5f) * scale), static_cast<int>((atY + 0.5f) * scale));
+            _gliding = t < 1.0f;
+            return;
+        }
+
+        _remainderX += moveX;
+        _remainderY += moveY;
+        const int stepX = static_cast<int>(_remainderX);
+        const int stepY = static_cast<int>(_remainderY);
+        _remainderX -= stepX;
+        _remainderY -= stepY;
+        if (stepX == 0 && stepY == 0)
+            return;
+
+        int atX, atY;
+        SDL_GetMouseState(&atX, &atY);
+        const int toX = std::clamp(atX + stepX, 0, width - 1);
+        const int toY = std::clamp(atY + stepY, 0, height - 1);
+        SDL_WarpMouseInWindow(_window, toX, toY);
+
+        // Pushing against the edge of the screen over the park scrolls it.
+        const ScreenCoordsXY overflow = { atX + stepX - toX, atY + stepY - toY };
+        if ((overflow.x != 0 || overflow.y != 0) && IsOverPark(pointer()) && gLegacyScene != LegacyScene::titleSequence)
+        {
+            auto* mainWindow = WindowGetMain();
+            if (mainWindow != nullptr)
+            {
+                WindowUnfollowSprite(*mainWindow);
+                InputScrollViewportSmooth(
+                    { static_cast<int32_t>(overflow.x / scale), static_cast<int32_t>(overflow.y / scale) }, mainWindow);
+            }
+        }
+    }
+
+    void Gamepad::setButton(uint8_t button, bool pressed, bool& state)
+    {
+        if (pressed == state)
+            return;
+        state = pressed;
+
+        // A click lands where the pointer was going.
+        if (pressed && _gliding)
+        {
+            const float scale = Config::Get().general.windowScale;
+            SDL_WarpMouseInWindow(
+                _window, static_cast<int>((_glideTo.x + 0.5f) * scale), static_cast<int>((_glideTo.y + 0.5f) * scale));
+            _gliding = false;
+        }
+
+        SDL_Event e{};
+        e.button.type = pressed ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+        e.button.timestamp = SDL_GetTicks();
+        e.button.windowID = SDL_GetWindowID(_window);
+        e.button.button = button;
+        e.button.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+        e.button.clicks = 1;
+        SDL_GetMouseState(&e.button.x, &e.button.y);
+        SDL_PushEvent(&e);
+    }
+
+    // A left click somewhere other than the pointer.
+    void Gamepad::clickAt(const ScreenCoordsXY& position)
+    {
+        const float scale = Config::Get().general.windowScale;
+        SDL_Event e{};
+        e.button.windowID = SDL_GetWindowID(_window);
+        e.button.button = SDL_BUTTON_LEFT;
+        e.button.clicks = 1;
+        e.button.x = static_cast<int32_t>((position.x + 0.5f) * scale);
+        e.button.y = static_cast<int32_t>((position.y + 0.5f) * scale);
+        for (const bool pressed : { true, false })
+        {
+            e.button.type = pressed ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+            e.button.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+            e.button.timestamp = SDL_GetTicks();
+            SDL_PushEvent(&e);
+        }
+    }
+
+    void Gamepad::rumble(uint16_t low, uint16_t high, uint32_t milliseconds) const
+    {
+        for (auto* controller : _controllers)
+            SDL_GameControllerRumble(controller, low, high, milliseconds);
+    }
+
+#pragma endregion
+} // namespace OpenRCT2::Ui
