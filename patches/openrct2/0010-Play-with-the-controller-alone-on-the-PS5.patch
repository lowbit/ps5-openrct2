+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <openrct2/interface/ScreenCoords.hpp>
+#include <vector>
+
+typedef struct _SDL_GameController SDL_GameController;
+struct SDL_Window;
+
+namespace OpenRCT2::Ui
+{
+    /**
+     * Plays the game with a controller alone, for platforms without a mouse (the PS5).
+     *
+     * The left stick and the touchpad move the mouse pointer: slower over buttons, faster when the
+     * stick is held at full tilt. Cross clicks, Square right-clicks, Circle goes back (closes a
+     * dropdown, leaves a tool, closes a window). The d-pad jumps the pointer from button to button,
+     * through lists and dropdowns, and out of the park to the nearest window. L1 and R1 switch tabs
+     * of the window under the pointer, or rotate the view; L2 and R2 zoom. While building track or
+     * a bridge, with the pointer in the park, the d-pad picks the piece, Cross builds it and Square
+     * takes it away. Everything else works as with a mouse, since the pointer is the real one.
+     */
+    class Gamepad final
+    {
+    public:
+        void update(const std::vector<SDL_GameController*>& controllers);
+
+        // The right stick scrolls the list under the pointer rather than the park: returns whether
+        // there was one.
+        static bool scrollList(const ScreenCoordsXY& delta);
+
+    private:
+        enum Button : uint8_t
+        {
+            cross,
+            circle,
+            square,
+            triangle,
+            l1,
+            r1,
+            l2,
+            r2,
+            l3,
+            r3,
+            options,
+            touchpad,
+            up,
+            down,
+            left,
+            right,
+            count,
+        };
+
+        struct ButtonState
+        {
+            bool held = false;
+            bool fired = false; // pressed, or repeating, this frame
+            uint32_t pressedAt = 0;
+            uint32_t repeatAt = 0;
+        };
+
+        enum class Press : uint8_t
+        {
+            none,
+            mouse,
+            construction,
+        };
+
+        std::vector<SDL_GameController*> _controllers;
+        SDL_Window* _window = nullptr;
+        uint32_t _ticks = 0;
+        float _frameSeconds = 0.0f;
+        std::array<ButtonState, Button::count> _buttons{};
+
+        bool _placed = false;
+        float _remainderX = 0.0f;
+        float _remainderY = 0.0f;
+        float _fullTiltSeconds = 0.0f;
+        bool _touching = false;
+        float _touchX = 0.0f;
+        float _touchY = 0.0f;
+
+        // The pointer glides to where the d-pad sent it.
+        bool _gliding = false;
+        uint32_t _glideStart = 0;
+        ScreenCoordsXY _glideFrom;
+        ScreenCoordsXY _glideTo;
+
+        bool _left = false;
+        bool _right = false;
+        Press _crossPress = Press::none;
+        Press _squarePress = Press::none;
+        bool _dropdownOpen = false;
+        bool _crossOpenedDropdown = false;
+
+        void readButtons();
+        bool fired(Button button) const;
+        bool held(Button button) const;
+        float axis(int axis) const;
+
+        void movePointer();
+        void handleButtons();
+        void handleDirection(int dx, int dy);
+        void back();
+        bool switchTab(int step);
+
+        ScreenCoordsXY pointer() const;
+        void sendPointerTo(const ScreenCoordsXY& position);
+        void setButton(uint8_t button, bool pressed, bool& state);
+        void clickAt(const ScreenCoordsXY& position);
+        void rumble(uint16_t low, uint16_t high, uint32_t milliseconds) const;
+    };
+} // namespace OpenRCT2::Ui
