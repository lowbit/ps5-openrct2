From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rijads <spaha92@gmail.com>
Date: Sun, 4 Oct 2026 21:34:21 +0200
Subject: [PATCH] Add a quick menu of build tools at the pointer, on Options on
 the PS5

A controller's pointer is a long way from the top toolbar. The quick menu shows the toolbar's
build tools (ride, footpath, scenery, land, water, clear scenery) and park windows (rides, park,
guests, map) around the pointer; each button runs the toolbar's shortcut. Pressing Options
again closes it.
---
 src/openrct2-ui/input/Shortcuts.cpp    |   6 ++
 src/openrct2-ui/windows/QuickMenu.cpp  | 114 +++++++++++++++++++++++++
 src/openrct2-ui/windows/Windows.h      |   1 +
 src/openrct2/interface/WindowClasses.h |   1 +
 4 files changed, 122 insertions(+)
 create mode 100644 src/openrct2-ui/windows/QuickMenu.cpp

diff --git a/src/openrct2-ui/input/Shortcuts.cpp b/src/openrct2-ui/input/Shortcuts.cpp
index e3a2868..0d9345f 100644
--- a/src/openrct2-ui/input/Shortcuts.cpp
+++ b/src/openrct2-ui/input/Shortcuts.cpp
@@ -921,10 +921,16 @@ void ShortcutManager::registerDefaultShortcuts()
     // clang-format on
 
 #ifdef __PROSPERO__
+    registerShortcut(RegisteredShortcut("interface.open.quick_menu", "Quick menu (build tools)", []() {
+        if (gLegacyScene != LegacyScene::titleSequence)
+            QuickMenuToggle();
+    }));
+
     // The PS5 is played with a DualSense. The left stick, Cross, Square, Circle and the touchpad
     // drive the pointer (GamepadPointer) and the right stick scrolls; these are the other buttons.
     // JOY numbers count from 1 in SDL's PS5 button order.
     static constexpr std::pair<std::string_view, std::string_view> kControllerDefaults[] = {
+        { "interface.open.quick_menu", "JOY 7" },                      // Options
         { ShortcutId::kInterfaceCloseAll, "JOY 4" },                   // Triangle
         { ShortcutId::kViewGeneralRotateAnticlockwise, "JOY 10" },     // L1
         { ShortcutId::kViewGeneralRotateClockwise, "JOY 11" },         // R1
