+
+    static constexpr RadialEntry kParkEntries[] = {
+        { SPR_TOOLBAR_RIDES, STR_RIDES_IN_PARK_TIP, ShortcutId::kInterfaceOpenRides },
+        { SPR_TOOLBAR_PARK, STR_PARK_INFORMATION_TIP, ShortcutId::kInterfaceOpenPark },
+        { SPR_TOOLBAR_GUESTS, STR_GUESTS_TIP, ShortcutId::kInterfaceOpenGuests },
+        { SPR_TAB_TOOLBAR, STR_STAFF_TIP, ShortcutId::kInterfaceOpenStaff, SPR_TOOLBAR_STAFF },
+        { SPR_TAB_TOOLBAR, STR_SCENARIO_OPTIONS_FINANCIAL_TIP, ShortcutId::kInterfaceOpenFinances, SPR_FINANCE, { 3, 1 } },
+        { SPR_TAB_TOOLBAR,
+          STR_FINANCES_RESEARCH_TIP,
+          ShortcutId::kInterfaceOpenResearch,
+          SPR_TAB_FINANCES_RESEARCH_0,
+          { -1, 0 } },
+        { SPR_TAB_TOOLBAR, STR_SHOW_RECENT_MESSAGES_TIP, ShortcutId::kInterfaceOpenMessages, SPR_G2_TAB_NEWS, { 3, 0 } },
+        { SPR_TOOLBAR_MAP, STR_SHOW_MAP_TIP, ShortcutId::kInterfaceOpenMap },
+    };
+
+    static constexpr size_t kMaxEntries = std::max(std::size(kBuildEntries), std::size(kParkEntries));
+    static constexpr ScreenSize kButtonSize = { 30, 28 };
+    static constexpr int32_t kRadius = 52;
+    static constexpr int32_t kLabelHeight = 14;
+    static constexpr ScreenSize kWindowSize = { 240, 2 * kRadius + kButtonSize.height + 2 * kLabelHeight + 8 };
+    static constexpr ScreenCoordsXY kCentre = { kWindowSize.width / 2, kRadius + kButtonSize.height / 2 + 4 };
+
+    static std::span<const RadialEntry> Entries(RadialMenu menu)
+    {
+        return menu == RadialMenu::build ? std::span<const RadialEntry>(kBuildEntries)
+                                         : std::span<const RadialEntry>(kParkEntries);
+    }
+
+    // The first entry is at the top, the rest follow clockwise.
+    static ScreenCoordsXY EntryCentre(size_t index, size_t count)
+    {
+        const double angle = 2 * std::numbers::pi * index / count;
+        return kCentre
+            + ScreenCoordsXY{ static_cast<int32_t>(std::lround(kRadius * std::sin(angle))),
+                              static_cast<int32_t>(std::lround(-kRadius * std::cos(angle))) };
+    }
+
+    class RadialMenuWindow final : public Window
+    {
+        RadialMenu _menu{};
+        std::span<const RadialEntry> _entries;
+        std::array<Widget, kMaxEntries> _widgets{};
+        int32_t _highlighted = -1;
+
+    public:
+        explicit RadialMenuWindow(RadialMenu menu)
+            : _menu(menu)
+            , _entries(Entries(menu))
+        {
+        }
+
+        RadialMenu menu() const
+        {
+            return _menu;
+        }
+
+        void onOpen() override
+        {
+            for (size_t i = 0; i < _entries.size(); i++)
+            {
+                const auto topLeft = EntryCentre(i, _entries.size())
+                    - ScreenCoordsXY{ kButtonSize.width / 2, kButtonSize.height / 2 };
+                _widgets[i] = makeRemapWidget(
+                    topLeft, kButtonSize, WidgetType::trnBtn, WindowColour::tertiary, _entries[i].image, _entries[i].name);
+            }
+            setWidgets(std::span<const Widget>(_widgets.data(), _entries.size()));
+        }
+
+        // Highlights the entry in the direction (x, y), screen-wise; returns whether that changed.
+        bool point(float x, float y)
+        {
+            const double turn = std::atan2(x, -y) / (2 * std::numbers::pi);
+            const auto count = static_cast<int32_t>(_entries.size());
+            const int32_t index = ((static_cast<int32_t>(std::lround(turn * count)) % count) + count) % count;
+            if (index == _highlighted)
+                return false;
+            _highlighted = index;
+            for (size_t i = 0; i < _entries.size(); i++)
+                setWidgetPressed(static_cast<WidgetIndex>(i), static_cast<int32_t>(i) == _highlighted);
+            invalidate();
+            return true;
+        }
+
+        std::optional<std::string_view> highlighted() const
+        {
+            if (_highlighted < 0)
+                return std::nullopt;
+            return _entries[_highlighted].shortcut;
+        }
+
+        void onDraw(RenderTarget& rt) override
+        {
+            // A dark disc behind the ring, and a band for the name under it.
+            const int32_t radius = kRadius + kButtonSize.height / 2 + 6;
+            const auto centre = windowPos + kCentre;
+            for (int32_t dy = -radius; dy <= radius; dy++)
+            {
+                const auto half = static_cast<int32_t>(std::sqrt(static_cast<double>(radius * radius - dy * dy)));
+                Rectangle::filter(
+                    rt, { centre + ScreenCoordsXY{ -half, dy }, centre + ScreenCoordsXY{ half, dy } },
+                    FilterPaletteID::paletteDarken2);
+            }
+
+            drawWidgets(rt);
+            const auto& park = getGameState().park;
+            for (size_t i = 0; i < _entries.size(); i++)
+            {
+                const auto& entry = _entries[i];
+                if (entry.overlay == kImageIndexUndefined)
+                    continue;
+                auto at = windowPos + ScreenCoordsXY{ widgets[i].left, widgets[i].top } + entry.overlayOffset;
+                if (isWidgetPressed(static_cast<WidgetIndex>(i)))
+                    at.y++;
+                const auto image = entry.overlay == SPR_TOOLBAR_STAFF
+                    ? ImageId(entry.overlay, park.staffHandymanColour, park.staffMechanicColour)
+                    : ImageId(entry.overlay);
+                GfxDrawSprite(rt, image, at);
+            }
+
+            if (_highlighted >= 0)
+            {
+                const ScreenCoordsXY labelTop = { windowPos.x + 2, centre.y + radius + 4 };
+                Rectangle::filter(
+                    rt, { labelTop, labelTop + ScreenCoordsXY{ kWindowSize.width - 5, 2 * kLabelHeight - 4 } },
+                    FilterPaletteID::paletteDarken2);
+                drawTextWrapped(
+                    rt, { centre.x, labelTop.y + 2 }, kWindowSize.width - 8, _entries[_highlighted].name,
+                    { Colour::white, TextAlignment::centre });
+            }
+        }
+    };
+
+    static RadialMenuWindow* FindRadialMenu()
+    {
+        return static_cast<RadialMenuWindow*>(GetWindowManager()->FindByClass(WindowClass::radialMenu));
+    }
+
+    void RadialMenuOpen(RadialMenu menu)
+    {
+        auto* windowMgr = GetWindowManager();
+        windowMgr->CloseByClass(WindowClass::radialMenu);
+        const ScreenCoordsXY position = { (ContextGetWidth() - kWindowSize.width) / 2,
+                                          (ContextGetHeight() - kWindowSize.height) / 2 };
+        windowMgr->Create<RadialMenuWindow>(
+            WindowClass::radialMenu, position, kWindowSize,
+            { WindowFlag::stickToFront, WindowFlag::transparent, WindowFlag::noBackground, WindowFlag::noTitleBar }, menu);
+    }
+
+    std::optional<RadialMenu> RadialMenuShown()
+    {
+        if (auto* w = FindRadialMenu())
+            return w->menu();
+        return std::nullopt;
+    }
+
+    bool RadialMenuPoint(float x, float y)
+    {
+        auto* w = FindRadialMenu();
+        return w != nullptr && w->point(x, y);
+    }
+
+    bool RadialMenuChoose()
+    {
+        auto* w = FindRadialMenu();
+        if (w == nullptr)
+            return false;
+        const auto shortcutId = w->highlighted();
+        if (!shortcutId)
+            return false;
+        GetWindowManager()->Close(*w);
+        if (auto* shortcut = GetShortcutManager().getShortcut(*shortcutId))
+            shortcut->action();
+        return true;
+    }
+
+    void RadialMenuClose()
+    {
+        GetWindowManager()->CloseByClass(WindowClass::radialMenu);
+    }
+} // namespace OpenRCT2::Ui::Windows
