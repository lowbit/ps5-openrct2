+    // While a radial menu is shown the stick or the d-pad points at an entry. Letting go of the
+    // button that opened it runs that entry; tapped, the menu stays until Cross picks one, or Circle
+    // or the button again closes it.
+    void Gamepad::handleRadialMenu()
+    {
+        setButton(SDL_BUTTON_LEFT, false, _left);
+        setButton(SDL_BUTTON_RIGHT, false, _right);
+
+        bool pointed = false;
+        const float x = axis(SDL_CONTROLLER_AXIS_LEFTX);
+        const float y = axis(SDL_CONTROLLER_AXIS_LEFTY);
+        if (std::hypot(x, y) > 0.5f)
+            pointed = RadialMenuPoint(x, y);
+        const int dx = held(Button::right) - held(Button::left);
+        const int dy = held(Button::down) - held(Button::up);
+        if ((fired(Button::up) || fired(Button::down) || fired(Button::left) || fired(Button::right)) && (dx != 0 || dy != 0))
+            pointed |= RadialMenuPoint(static_cast<float>(dx), static_cast<float>(dy));
+        if (pointed)
+        {
+            _radialPointed = true;
+            rumble(0, 0x2000, 12);
+        }
+
+        const bool buttonHeld = held(_radialButton);
+        if (fired(Button::cross) || (_radialButtonHeld && !buttonHeld && _radialPointed))
+        {
+            if (RadialMenuChoose())
+                rumble(0x1800, 0x2400, 18);
+        }
+        else if (fired(Button::circle) || fired(_radialButton))
+        {
+            RadialMenuClose();
+        }
+        _radialButtonHeld = buttonHeld;
+    }
