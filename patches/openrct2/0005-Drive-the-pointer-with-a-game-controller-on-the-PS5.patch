+ *****************************************************************************/
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+typedef struct _SDL_GameController SDL_GameController;
+struct SDL_Window;
+
+namespace OpenRCT2::Ui
+{
+    /**
+     * Drives the mouse pointer with a game controller, for platforms played without a mouse:
+     * the left stick and the touchpad move it, Cross (A) and a touchpad click are the left
+     * button, Square (X) the right button, and holding Circle (B) moves it faster. It moves the
+     * real pointer and sends ordinary mouse button events, so everything else works as with a
+     * mouse.
+     */
+    class GamepadPointer final
+    {
+    public:
+        void update(const std::vector<SDL_GameController*>& controllers);
+
+    private:
+        uint32_t _lastTicks = 0;
+        bool _placed = false;
+        float _remainderX = 0.0f;
+        float _remainderY = 0.0f;
+        bool _touching = false;
+        float _touchX = 0.0f;
+        float _touchY = 0.0f;
+        bool _left = false;
+        bool _right = false;
+
+        void setButton(SDL_Window* window, uint8_t button, bool pressed, bool& state);
+    };
+} // namespace OpenRCT2::Ui
