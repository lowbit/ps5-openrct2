@@ -136,6 +136,15 @@ void InputManager::checkJoysticks()
     }
 }
 
+#ifdef __PROSPERO__
+// The left stick drives the pointer (GamepadPointer), so the right one scrolls.
+static constexpr auto kScrollAxisX = SDL_CONTROLLER_AXIS_RIGHTX;
+static constexpr auto kScrollAxisY = SDL_CONTROLLER_AXIS_RIGHTY;
+#else
+static constexpr auto kScrollAxisX = SDL_CONTROLLER_AXIS_LEFTX;
+static constexpr auto kScrollAxisY = SDL_CONTROLLER_AXIS_LEFTY;
+#endif
+
 void InputManager::processAnalogueInput()
 {
     _analogueScroll.x = 0;
@@ -148,8 +157,8 @@ void InputManager::processAnalogueInput()
     {
         if (gameController != nullptr)
         {
-            int32_t stickX = SDL_GameControllerGetAxis(gameController, SDL_CONTROLLER_AXIS_LEFTX);
-            int32_t stickY = SDL_GameControllerGetAxis(gameController, SDL_CONTROLLER_AXIS_LEFTY);
+            int32_t stickX = SDL_GameControllerGetAxis(gameController, kScrollAxisX);
+            int32_t stickY = SDL_GameControllerGetAxis(gameController, kScrollAxisY);
 
             // Calculate the magnitude of the stick input vector
             float magnitude = std::sqrt(static_cast<float>(stickX * stickX + stickY * stickY));
@@ -199,6 +208,9 @@ void InputManager::updateAnalogueScroll()
 void InputManager::process()
 {
     checkJoysticks();
+#ifdef __PROSPERO__
+    _gamepadPointer.update(_gameControllers);
+#endif
     processAnalogueInput();
     handleModifiers();
     processEvents();
