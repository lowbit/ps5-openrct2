+ *****************************************************************************/
+
+#include "GamepadPointer.h"
+
+#include <SDL.h>
+#include <algorithm>
+#include <cmath>
+
+namespace OpenRCT2::Ui
+{
+    // Below this tilt the stick counts as centred: worn sticks drift.
+    static constexpr float kDeadzone = 7000.0f;
+    // At full tilt the pointer crosses the window's height in this time.
+    static constexpr float kSecondsPerHeight = 1.2f;
+    // Holding Circle (B) multiplies the speed by this.
+    static constexpr float kFastFactor = 2.5f;
+    // The longest frame the movement accounts for, so a stall does not throw the pointer away.
+    static constexpr float kMaxFrameSeconds = 0.1f;
+
+    void GamepadPointer::update(const std::vector<SDL_GameController*>& controllers)
+    {
+        const uint32_t ticks = SDL_GetTicks();
+        const float seconds = _lastTicks == 0 ? 0.0f : std::min((ticks - _lastTicks) / 1000.0f, kMaxFrameSeconds);
+        _lastTicks = ticks;
+
+        SDL_Window* window = SDL_GetMouseFocus();
+        if (window == nullptr)
+            return;
+        int width, height;
+        SDL_GetWindowSize(window, &width, &height);
+        if (!_placed)
+        {
+            // Start in the middle rather than in a corner.
+            SDL_WarpMouseInWindow(window, width / 2, height / 2);
+            _placed = true;
+        }
+
+        float moveX = 0.0f;
+        float moveY = 0.0f;
+        bool left = false;
+        bool right = false;
+        bool touching = false;
+        float touchX = 0.0f;
+        float touchY = 0.0f;
+        for (auto* controller : controllers)
+        {
+            const float x = SDL_GameControllerGetAxis(controller, SDL_CONTROLLER_AXIS_LEFTX);
+            const float y = SDL_GameControllerGetAxis(controller, SDL_CONTROLLER_AXIS_LEFTY);
+            const float magnitude = std::hypot(x, y);
+            if (magnitude > kDeadzone)
+            {
+                // Quadratic response: slow and precise near the centre, fast at full tilt.
+                const float tilt = std::min((magnitude - kDeadzone) / (32767.0f - kDeadzone), 1.0f);
+                float speed = tilt * tilt * height / kSecondsPerHeight;
+                if (SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_B))
+                    speed *= kFastFactor;
+                moveX += x / magnitude * speed * seconds;
+                moveY += y / magnitude * speed * seconds;
+            }
+
+            left |= SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_A)
+                || SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_TOUCHPAD);
+            right |= SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_X);
+
+            uint8_t state = 0;
+            float fingerX, fingerY, pressure;
+            if (!touching && SDL_GameControllerGetNumTouchpads(controller) > 0
+                && SDL_GameControllerGetTouchpadFinger(controller, 0, 0, &state, &fingerX, &fingerY, &pressure) == 0
+                && state != 0)
+            {
+                touching = true;
+                touchX = fingerX;
+                touchY = fingerY;
+            }
+        }
+
+        // The touchpad works like a laptop's: a stroke across all of it crosses the window.
+        if (touching && _touching)
+        {
+            moveX += (touchX - _touchX) * width;
+            moveY += (touchY - _touchY) * height;
+        }
+        _touching = touching;
+        _touchX = touchX;
+        _touchY = touchY;
+
+        _remainderX += moveX;
+        _remainderY += moveY;
+        const int stepX = static_cast<int>(_remainderX);
+        const int stepY = static_cast<int>(_remainderY);
+        _remainderX -= stepX;
+        _remainderY -= stepY;
+        if (stepX != 0 || stepY != 0)
+        {
+            int x, y;
+            SDL_GetMouseState(&x, &y);
+            SDL_WarpMouseInWindow(window, std::clamp(x + stepX, 0, width - 1), std::clamp(y + stepY, 0, height - 1));
+        }
+
+        setButton(window, SDL_BUTTON_LEFT, left, _left);
+        setButton(window, SDL_BUTTON_RIGHT, right, _right);
+    }
+
+    void GamepadPointer::setButton(SDL_Window* window, uint8_t button, bool pressed, bool& state)
+    {
+        if (pressed == state)
+            return;
+        state = pressed;
+
+        SDL_Event e{};
+        e.button.type = pressed ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+        e.button.timestamp = SDL_GetTicks();
+        e.button.windowID = SDL_GetWindowID(window);
+        e.button.button = button;
+        e.button.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+        e.button.clicks = 1;
+        SDL_GetMouseState(&e.button.x, &e.button.y);
+        SDL_PushEvent(&e);
+    }
+} // namespace OpenRCT2::Ui
